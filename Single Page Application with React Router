import React, { useState } from "react"; import "./App.css";

function App() {
const [task, setTask] = useState(""); const [tasks, setTasks] = useState([]); const [editId, setEditId] = useState(null);

// Add or Update Task const handleTask = () => {
if (task.trim() === "") return;


if (editId) {
setTasks(tasks.map((t) => (t.id === editId ? { ...t, text: task } : t))); setEditId(null);
setTask("");
} else {
setTasks([...tasks, { text: task, id: Date.now(), done: false }]); setTask("");
}
};


// Delete Task
const deleteTask = (id) => {
// Add 'removing' class for CSS animation
const element = document.getElementById(`task-${id}`); element.classList.add("remove");
setTimeout(() => { setTasks(tasks.filter((t) => t.id !== id));
}, 300); // match with CSS animation duration
 
};


// Edit Task
const editTask = (id) => {
const taskToEdit = tasks.find((t) => t.id === id); setTask(taskToEdit.text);
setEditId(id);
};


// Toggle Completed
const toggleDone = (id) => { setTasks(
tasks.map((t) => (t.id === id ? { ...t, done: !t.done } : t))
);
};


return (
<div className="container">
<div className="todo-card">
<h1>✨ To-Do List ✨</h1>


<input type="text" value={task}
onChange={(e) => setTask(e.target.value)} placeholder="Enter a task..."
/>


<button onClick={handleTask}>{editId ? "Update" : "Add"}</button>


<ul>
{tasks.map((t) => (
 
<li
key={t.id} id={`task-${t.id}`}
className={`task-item ${t.done ? "done" : ""} add`}
>
<span onClick={() => toggleDone(t.id)}>{t.text}</span>
<div className="buttons">
<button className="edit-btn" onClick={() => editTask(t.id)}> Edit
</button>
<button className="delete-btn" onClick={() => deleteTask(t.id)}> Delete
</button>
</div>
</li>
))}
</ul>
</div>
</div>
);
}


export default App; App.css:
