<?php
// Load Composer's autoloader for PHPMailer use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\Exception;

// This path assumes you installed PHPMailer via Composer in the parent directory require 'vendor/autoload.php';

if ($_SERVER["REQUEST_METHOD"] == "POST") {
// 1. Sanitize and retrieve form data
$name = htmlspecialchars($_POST['name']);
$email = htmlspecialchars($_POST['email']);
$message = htmlspecialchars($_POST['message']);

// 2. Initialize PHPMailer
$mail = new PHPMailer(true);

try {
// Server settings (Use your Mailtrap/SMTP details here)
 
$mail->isSMTP();
$mail->Host	= 'sandbox.smtp.mailtrap.io';	// Replace with your SMTP Host (e.g., smtp.mailtrap.io)
$mail->SMTPAuth = true;
$mail->Username  = '625da34704a5b1'; // Replace with your SMTP Username
$mail->Password  = '4c404978968f54'; // Replace with your SMTP Password
$mail->SMTPSecure = PHPMailer::ENCRYPTION_STARTTLS;
$mail->Port	= 2525; // Replace with your SMTP Port (e.g., 2525, 587)

// 3. Recipients
$mail->setFrom($email, $name);
$mail->addAddress('nitrajapndi2019@gmail.com', 'Admin'); // The address where you want to receive the email

// 4. Content
$mail->isHTML(true);
$mail->Subject = "New Contact Form Submission from " . $name;
$mail->Body	= "
<h2>New Message Received</h2>
<p><strong>Name:</strong> {$name}</p>
<p><strong>Email:</strong> {$email}</p>
<p><strong>Message:</strong></p>
<p>" . nl2br($message) . "</p>";
$mail->AltBody = "Name: {$name}\nEmail: {$email}\nMessage: {$message}";

// 5. Send
$mail->send();
echo "✅ Thank you! Your message has been sent successfully.";

} catch (Exception $e) {
// Display error if the email failed to send
echo "❌ Oops! Something went wrong. Mailer Error: {$mail->ErrorInfo}";
}
} else {
echo "Invalid request method.";
}
?>

