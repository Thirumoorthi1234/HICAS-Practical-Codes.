require('dotenv').config();
const express = require('express'); const jwt = require('jsonwebtoken'); const bcrypt = require('bcrypt');

const app = express(); app.use(express.json());

// In-memory user store (replace with DB in production) const users = [];

// config helpers
const SALT_ROUNDS = parseInt(process.env.BCRYPT_SALT_ROUNDS, 10) || 12; const JWT_SECRET = process.env.JWT_SECRET;
const JWT_EXPIRES_IN = process.env.JWT_EXPIRES_IN || '1h'; const PORT = process.env.PORT || 3000;

if (!JWT_SECRET) {
console.error('Missing JWT_SECRET in .env — exit.'); process.exit(1);
}


// Register endpoint
app.post('/register', async (req, res) => { try {
const { username, password } = req.body;
if (!username || !password) return res.status(400).json({ message: 'username & password required' });


const exists = users.find(u => u.username === username);
 
if (exists) return res.status(409).json({ message: 'username already taken' });


const hash = await bcrypt.hash(password, SALT_ROUNDS);
const user = { id: users.length + 1, username, passwordHash: hash }; users.push(user);

// return minimal user info (never return password/hash) res.status(201).json({ id: user.id, username: user.username });
} catch (err) { console.error(err);
res.status(500).json({ message: 'server error' });
}
});


// Login endpoint -> issues JWT app.post('/login', async (req, res) => { try {
const { username, password } = req.body;
if (!username || !password) return res.status(400).json({ message: 'username & password required' });


const user = users.find(u => u.username === username);
if (!user) return res.status(401).json({ message: 'invalid credentials' });


const ok = await bcrypt.compare(password, user.passwordHash);
if (!ok) return res.status(401).json({ message: 'invalid credentials' });


 




});
 
// create JWT (HS256). Keep payload minimal. const payload = { userId: user.id };
const token = jwt.sign(payload, JWT_SECRET, { algorithm: 'HS256', expiresIn: JWT_EXPIRES_IN
 
// Return token (client may store it in memory / HttpOnly cookie — see notes) res.json({ token });
} catch (err) { console.error(err);
res.status(500).json({ message: 'server error' });
}
});


// Middleware to protect routes
function authenticateJWT(req, res, next) { const auth = req.headers.authorization;
if (!auth) return res.status(401).json({ message: 'missing authorization header' });


 



});
 
const parts = auth.split(' ');
if (parts.length !== 2 || parts[0] !== 'Bearer') return res.status(401).json({ message: 'malformed token'
 


const token = parts[1];
// Verify and allow only specific algorithms for extra safety
jwt.verify(token, JWT_SECRET, { algorithms: ['HS256'] }, (err, payload) => { if (err) return res.status(401).json({ message: 'invalid or expired token' }); req.userId = payload.userId;
next();
});
}


// protected route example
app.get('/protected', authenticateJWT, (req, res) => {
res.json({ message: `Hello user ${req.userId} — this is protected.` });
});
 
// simple status
app.get('/', (req, res) => res.send('JWT + bcrypt demo running'));


app.listen(PORT, () => console.log(`Server running on port ${PORT}`));


